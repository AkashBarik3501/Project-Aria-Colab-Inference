ion}\"\n","}}\n","<|im_end|>\n","<|im_start|>user\n","{user_prompt}\n","<|im_end|>\n","<|im_start|>assistant\n","\"\"\"\n","    inputs = tokenizer(prompt, return_tensors=\"pt\").to(\"cuda\")\n","    outputs = model.generate(**inputs, max_new_tokens=256, temperature=0.2)\n","    input_len = inputs[\"input_ids\"].shape[-1]\n","    raw_response = tokenizer.decode(outputs[0][input_len:], skip_special_tokens=True)\n","\n","    try:\n","        structured_data = json.loads(raw_response[raw_response.find('{'):raw_response.rfind('}')+1])\n","    except Exception:\n","        structured_data = {\n","            \"thought_process\": \"Fallback applied\",\n","            \"response\": raw_response,\n","            \"action_required\": action\n","        }\n","\n","    res = requests.post(\n","        f\"{TUNNEL_URL}/save_aria_log\",\n","        json={\"filepath\": \"aria_interactive_log.json\", \"data\": structured_data},\n","        headers={\"Bypass-Tunnel-Remainder\": \"true\"}\n","    )\n","    return res.json()\n","\n","# Execution Test\n","print(\"✓ Sync Response:\", query_aria(\"Check my system status and disk space.\", action=\"CHECK_DISK_SPACE\"))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":429,"referenced_widgets":["5bb7ed85a4a74675a323205cb9dafe7f","6fcf239e04b14fa58b2264363c2bb4f7","6b5c2538289c4caabcb71fd22b8a0f6a","d88ca974a43b4defb25fef1f10535840","59f34eba9226498a8a94bec35c6e6420","dfa05d84696c41b6b084b03b32a35043","b6eeb429e73345c197f5236149554332","0892dd6c1a4a45ce8d608fffe390d904","5bd8cfd796084bff8fd46e592e31cabf","985273711b6e44fd8654f6ac5d2e127f","a92a6e00e99f423587da3045f0d3b4ff","470dae3ef45f4c6bb70e3f8f159f6c1b","fb599a4225fd4d33a47ec7af2c526307","1a65916e30ed4721aed31898db94b04d","d81cea257f334e0faa88928cb7b25298","f8db19ac80b047279b42a3c746a70f5f","c43d22f4efe44e73ab279e09386385b7","135df79c9dee462f9722a9a36ffba2f2","f9e309f3822a4e7e97eaceef65945f65","c0a6f1798c5e40c6976366de4b6735dd","11426adf7e7d4a798a21b653572e392c","b4689